{
  "name": "@nkzw/oxlint-config",
  "version": "3.0.1",
  "description": "Oxlint config with sensible defaults.",
  "keywords": [
    "autofix",
    "config",
    "defaults",
    "oxlint",
    "strict"
  ],
  "license": "MIT",
  "author": "Christoph Nakazawa <christoph.pojer@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git://github.com/nkzw-tech/oxlint-config.git"
  },
  "files": [
    "quality",
    "types",
    "index.js",
    "index.d.ts",
    "with-sorting.js",
    "with-sorting.d.ts"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./types/*": null,
    "./with-sorting": "./with-sorting.js",
    "./*": "./*"
  },
  "scripts": {
    "bench": "vitest bench --run --reporter=verbose",
    "bench:project": "node bench/project.mjs",
    "format": "oxfmt --write .",
    "lint": "oxlint .",
    "sync:types": "vitest run test/published-types.test.js --update",
    "test": "vitest run",
    "test:vite-plus": "vitest run --dir integration"
  },
  "dependencies": {
    "@nkzw/eslint-plugin": "^2.0.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.14.0"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsrs": "7.1.0-beta.tsrs3",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.94.0",
    "tsrs": ">=0.25.0-ts7.1.0-beta || ^7.1.0-beta.tsrs2"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    },
    "tsrs": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.21.0"
}
